# Contact form (Server Action → Resend). Manage real values in Infisical
# (per-project), injected via `infisical run` locally and synced to Vercel.
# Without RESEND_API_KEY the form validates but returns a graceful "email me
# directly" message instead of sending.

# Resend API key — https://resend.com/api-keys
RESEND_API_KEY=

# Optional. Defaults: recipient = profile.email; sender = onboarding@resend.dev
# (works without a verified domain when sending to the account owner). Set a
# verified-domain sender for production once a custom domain exists.
# CONTACT_TO=dimitrists97@gmail.com
# CONTACT_FROM=Portfolio <hello@yourdomain.com>
